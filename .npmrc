# @koromix/koffi-darwin-x64 and @koromix/koffi-win32-x64 are deliberate
# cross-architecture DIRECT dependencies, not optional ones. The universal macOS
# build has to contain the Intel koffi binary even when the build machine is
# Apple Silicon, and the Windows binary has to be resolvable for the packaging
# job. npm rejects both with EBADPLATFORM ("notsup") unless this is set, which
# would silently ship a universal app that is broken on Intel Macs.
force=true

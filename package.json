{
  "name": "keypress-ultimate",
  "version": "0.1.0",
  "private": true,
  "description": "Holds keyboard keys and mouse buttons down, but only while a chosen app is frontmost.",
  "author": "Jahaan Pardhanani",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "npm run test:data && npm run test:unit",
    "test:data": "node data/validate.mjs && node data/crosscheck.mjs",
    "test:unit": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@koromix/koffi-darwin-arm64": "^3.2.1",
    "@koromix/koffi-darwin-x64": "^3.2.1",
    "@koromix/koffi-win32-x64": "^3.2.1",
    "koffi": "^3.2.1",
    "motion": "^13.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
